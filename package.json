{
  "name": "thesocialspin",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "build:error-page": "node build-error-page.mjs",
    "build:custom-domain": "echo thesocialspin.fmoreno.me > ./dist/CNAME",
    "deploy": "pnpm run build && pnpm run build:custom-domain && pnpm run build:error-page && gh-pages -d dist",
    "test": "vitest",
    "format": "oxfmt src vite.config.mts oxfmt.config.ts",
    "format:check": "oxfmt --check src vite.config.mts oxfmt.config.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-popper-tooltip": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "sass-embedded": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "homepage": ".",
  "type": "module"
}
